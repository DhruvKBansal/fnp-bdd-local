    public static int count = 0;

    @AfterMethod
    public void updateProgress(ITestResult result) {
    	count++;

    	  ExecutionProgressBar.updateProgress(
    	   count,
    	   result.getMethod().getMethodName() + " Completed");
        webDriver.quit();
        
    }

    @AfterSuite
    public void flushReport() {
        extentReport.flush();
        ExecutionProgressBar.complete();

        try {

         Desktop.getDesktop().open(new File(System.getProperty("user.dir") + "/reports"));

        } catch (Exception e) {
         e.printStackTrace();
        }
    }
