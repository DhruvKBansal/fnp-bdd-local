    @Test(enabled = true, priority = 1)
    public void test01VerifyOTPPopupAfterValidRegistration() {
        extentTest = extentReport.createTest("Test case 1");

        HomePage homePageObject = new HomePage(webDriver, extentTest);

        homePageObject.clickOnElement("popup");
        homePageObject.verifyElementAfterClick("popup");
        homePageObject.clickOnElement("hiGuest");
        homePageObject.verifyElementAfterClick("hiGuest");
        homePageObject.clickOnElement("loginReg");
        homePageObject.verifyElementAfterClick("loginReg");
        homePageObject.clickOnElement("email");
        homePageObject.enterDataIntoElement("validEmail");
        homePageObject.clickOnElement("clickContinue");
        homePageObject.verifyElementAfterClick("clickContinue");
        homePageObject.clickOnElement("name");
        homePageObject.enterDataIntoElement("validName");
        homePageObject.verifyElementAfterDataEntry("validName");
        homePageObject.clickOnElement("countryDropDown");
        homePageObject.clickOnElement("indiaDropDown");
        homePageObject.verifyElementAfterClick("indiaDropDown");
        homePageObject.clickOnElement("number");
        homePageObject.enterDataIntoElement("validNumber");
        homePageObject.verifyElementAfterDataEntry("validNumber");
        homePageObject.clickOnElement("startGifting");
        homePageObject.verifyElementAfterClick("startGifting");

        homePageObject.captureScreenshotAndLog("TC01_OTP");
    }

